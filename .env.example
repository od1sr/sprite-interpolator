# Host ports published by Docker Compose. Change only those that conflict locally.
FRONTEND_PORT=5173
BACKEND_PORT=8000
AI_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379

# Browser-facing API URL. Keep the port in sync with BACKEND_PORT.
VITE_API_URL=http://localhost:8000/api/v1
# If you change FRONTEND_PORT, Compose adjusts the default CORS origins automatically.
# Set FRONTEND_ORIGINS explicitly only when opening the frontend through another hostname.

POSTGRES_DB=sprite_interpolator
POSTGRES_USER=sprite
POSTGRES_PASSWORD=sprite
